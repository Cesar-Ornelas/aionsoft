{
  "name": "aionsoft",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "website:dev": "bun run --cwd apps/website dev",
    "website:build": "bun run --cwd apps/website build",
    "website:preview": "bun run --cwd apps/website preview",
    "portal:dev": "bun run --cwd apps/portal dev",
    "portal:build": "bun run --cwd apps/portal build",
    "portal:preview": "bun run --cwd apps/portal preview",
    "portal:infra:config": "docker compose --env-file infra/portal/.env -f infra/portal/compose-dev.yaml config",
    "portal:infra:up": "docker compose --env-file infra/portal/.env -f infra/portal/compose-dev.yaml up -d",
    "portal:infra:down": "docker compose --env-file infra/portal/.env -f infra/portal/compose-dev.yaml down",
    "portal:infra:logs": "docker compose --env-file infra/portal/.env -f infra/portal/compose-dev.yaml logs -f",
    "portal:infra:ps": "docker compose --env-file infra/portal/.env -f infra/portal/compose-dev.yaml ps",
    "admin:dev": "bun run --cwd apps/admin dev",
    "admin:build": "bun run --cwd apps/admin build",
    "admin:preview": "bun run --cwd apps/admin preview",
    "admin:infra:config": "docker compose --env-file infra/admin/.env -f infra/admin/compose-dev.yaml config",
    "admin:infra:up": "docker compose --env-file infra/admin/.env -f infra/admin/compose-dev.yaml up -d",
    "admin:infra:down": "docker compose --env-file infra/admin/.env -f infra/admin/compose-dev.yaml down",
    "admin:infra:logs": "docker compose --env-file infra/admin/.env -f infra/admin/compose-dev.yaml logs -f",
    "admin:infra:ps": "docker compose --env-file infra/admin/.env -f infra/admin/compose-dev.yaml ps",
    "cell:dev": "bun run --cwd apps/cell dev",
    "cell:build": "bun run --cwd apps/cell build",
    "cell:test:operations": "bun run --cwd apps/cell test:operations",
    "cell:preview": "bun run --cwd apps/cell preview",
    "cell:test:management": "bun run --cwd apps/cell test:management",
    "cell:test:crm": "bun run --cwd apps/cell test:crm",
    "cell:test:catalog": "bun run --cwd apps/cell test:catalog",
    "cell:test:issues": "bun run --cwd apps/cell test:issues",
    "cell:test:billing": "bun run --cwd apps/cell test:billing",
    "cell:setup:pb": "bun run --cwd apps/cell setup:pb",
    "cell:infra:config": "docker compose --env-file infra/crm/.env -f infra/crm/compose-dev.yaml config",
    "cell:infra:up": "docker compose --env-file infra/crm/.env -f infra/crm/compose-dev.yaml up -d",
    "cell:infra:down": "docker compose --env-file infra/crm/.env -f infra/crm/compose-dev.yaml down",
    "cell:infra:logs": "docker compose --env-file infra/crm/.env -f infra/crm/compose-dev.yaml logs -f",
    "cell:infra:ps": "docker compose --env-file infra/crm/.env -f infra/crm/compose-dev.yaml ps"
  },
  "type": "module"
}
